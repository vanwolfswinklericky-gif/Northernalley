{
  "expo": {
    "name": "Northernalley",
    "slug": "northernalley",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/splash-logo.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "image": "./src/assets/images/splash-logo.png",
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.northernalley.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.northernalley.app",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/splash-logo.png",
        "backgroundColor": "#000000"
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1b5c1af0-930c-4c81-a0ed-da8db8700b93"
      }
    }
  }
}
