{
  "expo": {
    "name": "Northernalley",
    "slug": "northernalley",
    "scheme": "northernalley",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "ios": {
      "bundleIdentifier": "com.northernalley.app",
      "supportsTablet": true,
      "associatedDomains": [
        "webcredentials:your-domain.com"
      ]
    },
    "android": {
      "package": "com.northernalley.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/splash-logo.png",
        "backgroundColor": "#000000"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "636422e0-53d7-4d68-bf6b-cc18832567a0"
      }
    }
  }
}
