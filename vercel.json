{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --legacy-peer-deps",
  "crons": [
    { "path": "/api/cron/dca", "schedule": "0 9 * * *" }
  ],
  "functions": {
    "api/**/*.js": {
      "includeFiles": "{node_modules/@hpke/**,node_modules/@privy-io/**}"
    }
  },
  "rewrites": [
    { "source": "/auth/verify-password", "destination": "/api/auth" },
    { "source": "/auth/register-password", "destination": "/api/auth" },
    { "source": "/auth/check-user", "destination": "/api/auth" },
    { "source": "/auth/sync-user", "destination": "/api/auth" },
    { "source": "/auth/signout", "destination": "/api/auth" },
    { "source": "/api/hello", "destination": "/api/user-data" },
    { "source": "/api/me", "destination": "/api/user-data" },
    { "source": "/api/upload-avatar", "destination": "/api/user" },
    { "source": "/api/delete-user", "destination": "/api/user" }
  ]
}